{
  // The cross-store catalog. Not deployed: account, database ids and the custom domain
  // are filled in at deploy time, on the owner's go. See catalog/README.md.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dinkuskit-catalog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "CATALOG_DB", "database_name": "dinkuskit-catalog", "database_id": "00000000-0000-0000-0000-000000000020", "migrations_dir": "./migrations" },
    { "binding": "MERCHANT_DB", "database_name": "dinkuskit-merchant-local", "database_id": "00000000-0000-0000-0000-000000000001" }
  ],
  "ratelimits": [
    { "name": "NAMED_AGENT_LIMIT", "namespace_id": "2001", "simple": { "limit": 50, "period": 10 } },
    { "name": "UNNAMED_AGENT_LIMIT", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
