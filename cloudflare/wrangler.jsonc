{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dinkuskit-website-cloudflare-candidate",
  "main": "./worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinkuskit-website-candidate",
      "database_id": "local-dinkuskit-website-candidate-d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dinkuskit-website-candidate-media"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
