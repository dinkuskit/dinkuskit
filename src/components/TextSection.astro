---
import type { BlockComponentProps, BlockValue } from 'emdash/ui';
import { safeHttpUrl } from '../../scripts/lib/safe-http-url.mjs';

type TextSectionValue = BlockValue & {
  heading?: string;
  body?: string;
  link_href?: string;
  link_label?: string;
  second_link_href?: string;
  second_link_label?: string;
  plugin_logo?: string;
};

// The plugin logos an editor can put on a card; the files are in public/brand.
const PLUGIN_LOGOS: Record<string, string> = {
  Commerce: '/brand/commerce.webp',
  Payments: '/brand/payments.webp',
  Inventory: '/brand/inventory.webp',
  Ship: '/brand/ship.webp',
};

const { value } = Astro.props as BlockComponentProps<TextSectionValue>;

const links = [
  { href: safeHttpUrl(value.link_href), label: value.link_label?.trim() },
  { href: safeHttpUrl(value.second_link_href), label: value.second_link_label?.trim() },
].filter((link): link is { href: string; label: string } => Boolean(link.href && link.label));
const logo = value.plugin_logo && Object.hasOwn(PLUGIN_LOGOS, value.plugin_logo)
  ? { src: PLUGIN_LOGOS[value.plugin_logo], alt: `DinkusKit ${value.plugin_logo}` }
  : undefined;
---
<section class:list={['text-section', { 'has-logo': logo }]}>
  {logo && <img class="text-section-logo" src={logo.src} alt={logo.alt} width="56" height="56" />}
  {value.heading && <h2>{value.heading}</h2>}
  {(value.body || links.length > 0) && (
    <div class="text-section-copy">
      {value.body && <p>{value.body}</p>}
      {links.length > 0 && (
        <ul class="text-section-links">
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  )}
</section>
