{
  "name": "@dinkuskit/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The EmDash-powered DinkusKit website and hosted-service account foundation",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "setup": "node scripts/generate-migration-sql.mjs && node scripts/prepare-local.mjs",
    "migrations:sql": "node scripts/generate-migration-sql.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "dev:account": "wrangler dev --local --persist-to .local/wrangler --port 8787 --ip 127.0.0.1 --config dist/server/wrangler.json",
    "build": "astro build",
    "start": "wrangler dev --local --persist-to .local/wrangler --port 8787 --ip 127.0.0.1 --config dist/server/wrangler.json",
    "types:wrangler": "wrangler types --config wrangler.jsonc --env-interface MerchantWorkerEnv --include-runtime false",
    "typecheck": "astro check",
    "audit:repo": "node scripts/audit-repo.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:account": "node --experimental-strip-types --test tests/emdash-public-auth-feasibility.test.mjs tests/merchant-unavailable-page.test.mjs",
    "test:e2e-contract": "node --test tests/e2e/run-contract.test.mjs",
    "test:e2e-mailbox-contract": "node --test tests/e2e/mailbox-contract.test.mjs",
    "test:merchant": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=180000 tests/better-auth-routes.test.mjs tests/store-connections.test.mjs tests/merchant-migrations.test.mjs tests/cms-merchant-isolation.test.mjs",
    "test:foundation": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=180000 tests/account-foundation.test.mjs tests/account-pages.test.mjs tests/start-page.test.mjs",
    "test:inventory-overview": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=180000 tests/inventory-overview.test.mjs tests/inventory-overview-routes.test.mjs",
    "test:inventory-runner": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=180000 tests/inventory-memory-runner.test.mjs",
    "test:organization-approvals": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=180000 tests/organization-approvals-unit.test.mjs tests/organization-approvals.test.mjs",
    "test:operator-admin": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=180000 tests/operator-admin-unit.test.mjs tests/operator-admin.test.mjs",
    "inventory:runner": "node --experimental-strip-types scripts/inventory-memory-runner.mjs --serve",
    "test:dev-cms": "node scripts/dev-cms.mjs",
    "test:public-release-reuse": "node scripts/test-public-release-reuse.mjs",
    "test:cms-operation-helpers": "node scripts/test-cms-operation-helpers.mjs",
    "test:access-gate": "node scripts/test-access-namespace-gate.mjs",
    "test:cms-operation": "node scripts/cms-operation-fixture.mjs",
    "test:cloudflare-candidate": "node scripts/cloudflare-candidate-denial.mjs",
    "test:safe-http-url": "node scripts/test-safe-http-url.mjs",
    "build:cloudflare": "astro build --config astro.cloudflare.config.mjs",
    "verify": "npm run audit:repo && npm run test:history-archive && npm run test:guide-ui && npm run build:dinkusguide-plugin && npm run test:dinkusguide-plugin && npm run setup && npm run types:wrangler && npm run typecheck && npm run test:theme-switch && npm run test:docs && npm run test:account && npm run test:e2e-contract && npm run test:e2e-mailbox-contract && npm run build && npm run test:docs-routes && npm run test:pages-import && npm run test:docs-sync && npm run test:agent-routes && npm run test:inventory-runner && npm run test:merchant && npm run test:shared-store && npm run test:foundation && npm run test:inventory-overview && npm run test:organization-approvals && npm run test:operator-admin && npm run test:smoke && npm run test:dev-cms && npm run test:public-release-reuse && npm run test:cms-operation-helpers && npm run test:access-gate && npm run test:safe-http-url && npm run test:workers-builds && npm run test:cms-operation && npm run test:emdash-upgrade && npm run test:cloudflare-candidate",
    "prepare:public-release": "npm run setup && npm run build && node scripts/prepare-public-release.mjs",
    "test:emdash-upgrade": "node scripts/cms-operation-fixture.mjs --upgrade",
    "test:shared-store": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=180000 tests/shared-store-isolation.test.mjs tests/plugin-connect.test.mjs tests/shared-store-routes.test.mjs tests/ship-sign-in.test.mjs",
    "test:agent-routes": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=180000 tests/agent-test-routes.test.mjs",
    "agent:test": "npm run setup && npm run build && node --experimental-strip-types scripts/agent-test-runner.mjs",
    "test:theme-switch": "node --experimental-strip-types --test tests/theme-switch.test.mjs",
    "test:docs": "node --experimental-strip-types --test tests/docs.test.mjs tests/docs-updates.test.mjs tests/docs-releases.test.mjs tests/docs-mcp.test.mjs tests/seo.test.mjs",
    "dev:docs": "astro dev --config fixtures/docs-preview/astro.config.mjs --host 127.0.0.1",
    "build:docs-preview": "astro build --config fixtures/docs-preview/astro.config.mjs",
    "test:docs-routes": "npm run build:docs-preview && node --experimental-strip-types scripts/test-docs-routes.mjs",
    "test:pages-import": "node --experimental-strip-types --test tests/footer-menu-order.test.mjs tests/social-links.test.mjs && node --experimental-strip-types scripts/test-pages-import.mjs",
    "docs:import": "node --experimental-strip-types scripts/docs-import.mjs push --url",
    "pages:import": "node --experimental-strip-types scripts/pages-import.mjs",
    "docs:pull": "node --experimental-strip-types scripts/docs-sync.mjs pull",
    "docs:release": "node --experimental-strip-types scripts/docs-sync.mjs release",
    "test:docs-sync": "node --experimental-strip-types scripts/test-docs-sync.mjs",
    "test:guide-ui": "node --experimental-strip-types --test tests/dinkusguide-ui.test.mjs",
    "test:guide-browser": "node scripts/dinkusguide-browser-proof.mjs",
    "build:dinkusguide-plugin": "node scripts/dinkusguide-plugin-build.mjs",
    "build:workers-builds": "node scripts/workers-builds.mjs",
    "test:workers-builds": "node --test tests/workers-builds.test.mjs",
    "test:dinkusguide-plugin": "node --experimental-strip-types --test tests/dinkusguide-plugin.test.mjs tests/dinkusguide-build.test.mjs && vitest run --config vitest.guide.config.mts",
    "test:history-archive": "python3 scripts/check-history-archive.py --check-git && python3 tests/history-archive.test.py"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "6.0.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@iconify-json/simple-icons": "1.2.100",
    "astro": "7.3.2",
    "astro-iconset": "0.0.6",
    "better-auth": "1.7.6",
    "better-sqlite3": "12.11.1",
    "deep-chat": "2.5.1",
    "emdash": "1.4.0",
    "jose": "6.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.3",
    "@cloudflare/workers-types": "5.20260926.1",
    "@emdash-cms/auth": "1.4.0",
    "@emdash-cms/cloudflare": "1.4.0",
    "@emdash-cms/plugin-cli": "0.13.5",
    "@emdash-cms/plugin-test": "0.2.11",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "marked": "17.0.6",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.144.0"
  },
  "overrides": {
    "@codemirror/language": "6.12.4"
  }
}
