---
import type { CollectionEntry } from 'astro:content';
import { docsSections, docsPath, pageLabels } from '../docs/catalog.ts';
interface Props { entries: CollectionEntry<'docs'>[]; activeId: string }
const { entries, activeId } = Astro.props;
const byId = new Map(entries.map(entry => [entry.id, entry]));
---
<nav class="docs-navigation" aria-label="Documentation">
  {docsSections.map(section => {
    const pages = section.pages.filter(id => byId.has(id));
    return pages.length > 0 && (
      <details open={pages.some(id => id === activeId)}>
        <summary>{section.title}</summary>
        <ul>
          {pages.map(id => (
            <li><a href={docsPath(id)} aria-current={id === activeId ? 'page' : undefined}>{pageLabels[id]}</a></li>
          ))}
        </ul>
      </details>
    );
  })}
</nav>
