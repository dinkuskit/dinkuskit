{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinkuskit-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "vars": {
    "EMDASH_SITE_URL": "https://dinkuskit.com"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinkuskit-cms-local",
      "database_id": "00000000-0000-0000-0000-000000000010"
    },
    {
      "binding": "MERCHANT_DB",
      "database_name": "dinkuskit-merchant-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations/merchant"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dinkuskit-media-local"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "00000000-0000-0000-0000-000000000011"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
