---
import { markdownPath } from '../../docs/catalog.ts';
import { getVisibleDocs } from '../../docs/content.ts';
import { docsSite } from '../../docs/site.ts';
import DocsArticle from '../../docs/components/DocsArticle.astro';
import Site from '../../layouts/Site.astro';
import { docsArticleJsonLd } from '../../seo.ts';
const entries = await getVisibleDocs();
const entry = entries.find(item => item.id === Astro.params.slug);
if (!entry) Astro.response.status = 404;
if (entry?.draft) {
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
  Astro.response.headers.set('Cache-Control', 'no-store');
} else if (entry) {
  Astro.response.headers.set('Link', `<${docsSite.origin}${markdownPath(entry.id)}>; rel="alternate"; type="text/markdown"`);
}
---
{entry ? (
  <Site
    title={entry.title}
    description={entry.summary}
    wide
    noindex={entry.draft}
    ogType="article"
    structured={entry.draft ? null : docsArticleJsonLd(entry)}
    markdownUrl={entry.draft ? undefined : markdownPath(entry.id)}
  ><DocsArticle site={docsSite} entry={entry} entries={entries} /></Site>
) : (
  <Site title="Page not found" description="This documentation page is not available." noindex><div class="intro"><h1>Page not found.</h1><p>This documentation page is not available.</p><a href="/getting-started">How it works</a></div></Site>
)}
