---
import Site from '../../layouts/Site.astro';
import { submitMagicLinkForm } from '../../account/actions.ts';
import { safeAccountPath } from '../../account/config.ts';

export const prerender = false;
if (Astro.request.method === 'POST') return submitMagicLinkForm(Astro, 'signup');
const error = Astro.url.searchParams.get('error');
const callbackURL = safeAccountPath(Astro.url.searchParams.get('callbackURL'), '');
const signinHref = callbackURL ? `/account/sign-in?callbackURL=${encodeURIComponent(callbackURL)}` : '/account/sign-in';
---
<Site title="Create account" description="Create a DinkusKit merchant account with your email and phone.">
  <div class="account-panel">
    <p class="eyebrow">Merchant account</p>
    <h1>Create your account</h1>
    <p class="lead">Use both contacts to create a merchant account. Either verified contact can qualify you; this is separate from the website editor.</p>
    <p class="account-note">Dedicated phone delivery is not available yet. Signup verification currently uses the email link; phone remains a required contact record.</p>
    {error ? <p class="account-error" role="alert">Complete the required contact, service, and agreement fields.</p> : null}
    <form method="post" action="/account/signup" class="account-form">
      {callbackURL ? <input type="hidden" name="callbackURL" value={callbackURL} /> : null}
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
      <label for="phone">Phone</label>
      <input id="phone" name="phone" type="tel" autocomplete="tel" required maxlength="16" placeholder="+15555550123" pattern={String.raw`\+[1-9][0-9]{6,14}`} aria-describedby="phone-format" />
      <small id="phone-format">Include + and country code, with no spaces.</small>
      <label for="service_channel">Required service/contact channel</label>
      <select id="service_channel" name="service_channel" required>
        <option value="">Choose one</option>
        <option value="email">Email</option>
        <option value="phone">Phone</option>
      </select>
      <label><input name="promotional_email" type="checkbox" /> Optional promotional email</label>
      <label><input name="promotional_sms" type="checkbox" /> Optional promotional SMS</label>
      <label><input name="agreement" type="checkbox" required /> I agree to the account terms</label>
      <button type="submit">Email me a signup link</button>
    </form>
    <p><a href={signinHref}>Already have an account? Sign in</a></p>
  </div>
</Site>
