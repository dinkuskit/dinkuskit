---
import Site from '../../layouts/Site.astro';
import { MerchantUnavailableError, seeOther, unavailableResponse } from '../../account/config.ts';
import { getMerchantEnv } from '../../account/bindings.ts';
import { listActiveBindings, revokeServiceGrant } from '../../account/store.ts';
import { rejectCrossOriginMutation } from '../../account/origin.ts';
import { authorizeOrganization } from '../../account/organizations.ts';
import { listStoreSetup, replaceStoreKey, setOwnerService } from '../../account/store-passes.ts';
import { COMING_SOON_SERVICES, OWNER_ENABLED_SERVICES, type OwnerEnabledService } from '../../account/config.ts';
import { checkoutSettingsJson, dollarsToMinor, loadCommerceSettings, readPaymentsBinding, saveCommerceSettings } from '../../account/commerce-settings.ts';
import { getInjectedTransports } from '../../account/transports.ts';

export const prerender = false;
Astro.response.headers.set('cache-control', 'private, no-store');
const merchant = Astro.locals.merchant;
if (!merchant) return seeOther('/account/sign-in');
let env;
try {
  env = await getMerchantEnv();
} catch (error) {
  if (error instanceof MerchantUnavailableError) return unavailableResponse();
  throw error;
}
let newKey: { siteId: string; key: string } | null = null;
// Shown on this response only: the checkout settings to paste, or why they could not be made.
let shown: { siteId: string; json?: string; note?: string; error?: string } | null = null;
const SETTINGS_ERROR: Record<string, string> = {
  invalid_amount: 'Enter the flat shipping charge in dollars, like 5 or 5.00.',
  forbidden: 'Only the owner of this business can set up Commerce for this store.',
  payments_not_connected: 'Payments is not connected for this store. Press Connect in the Payments plugin first.',
  payments_not_set_up: 'Payments has not finished setting up this store\'s Stripe or Authorize.net account. Finish it in the Payments plugin, then try again.',
  payments_unreachable: 'DinkusKit could not reach Payments just now. Try again in a minute.',
  signing_unavailable: 'DinkusKit cannot reach Payments right now. Try again later.',
};
if (Astro.request.method === 'POST') {
  const blocked = rejectCrossOriginMutation(Astro.request, env.MERCHANT_BASE_URL);
  if (blocked) return blocked;
  const form = await Astro.request.formData();
  const organizationId = String(form.get('organization_id') ?? '');
  if (organizationId !== merchant.organizationId) return new Response(JSON.stringify({ error: 'stale_organization' }), { status: 409 });
  const mutationMembership = await authorizeOrganization(env.MERCHANT_DB, merchant.userId, organizationId);
  if (!mutationMembership || mutationMembership.role !== 'owner') return new Response(JSON.stringify({ error: 'organization_forbidden' }), { status: 403 });
  const siteId = String(form.get('site_id') ?? '');
  const owner = { subject: merchant.subject, siteId, organizationId, actorUserId: merchant.userId };
  if (form.get('action') === 'revoke') {
    const service = String(form.get('service') ?? 'inventory');
    if (siteId) await revokeServiceGrant(env.MERCHANT_DB, merchant.subject, siteId, service, merchant.userId, organizationId);
  }
  const ownerService = form.get('service') as OwnerEnabledService;
  const turnOn = form.get('on') === '1';
  if (form.get('action') === 'service' && siteId && OWNER_ENABLED_SERVICES.includes(ownerService) && !(turnOn && COMING_SOON_SERVICES.includes(ownerService))) {
    await setOwnerService(env.MERCHANT_DB, { ...owner, service: ownerService, on: turnOn });
    // Commerce only calls the services its pasted settings name, so the owner pastes new ones.
    if (await loadCommerceSettings(env.MERCHANT_DB, siteId)) return seeOther(`/account/sites?changed=${encodeURIComponent(siteId)}`);
  }
  if (form.get('action') === 'checkout_settings' && siteId) {
    const flat = form.get('shipping_mode') === 'flat';
    const minor = flat ? dollarsToMinor(String(form.get('shipping_amount') ?? '')) : 0;
    const settings = minor === null ? null : await saveCommerceSettings(env.MERCHANT_DB, {
      ...owner, choices: { shippingMode: flat ? 'flat' : 'free', shippingMinor: minor, live: form.get('payments_mode') === 'live' },
    });
    if (minor === null || !settings) {
      shown = { siteId, error: SETTINGS_ERROR[minor === null ? 'invalid_amount' : 'forbidden'] };
    } else {
      const payments = await readPaymentsBinding({
        db: env.MERCHANT_DB, subject: merchant.subject, siteId, privateJwkJson: env.MERCHANT_JWT_PRIVATE_JWK,
        fetchStatus: getInjectedTransports().paymentsStatusFetch,
      });
      if (!payments.ok) {
        shown = { siteId, error: SETTINGS_ERROR[payments.reason] };
      } else {
        const store = (await listStoreSetup(env.MERCHANT_DB, merchant.subject)).find(row => row.siteId === siteId);
        shown = store ? {
          siteId,
          json: checkoutSettingsJson({ siteId, siteOrigin: store.siteOrigin, binding: payments.binding, settings, coupons: store.services.coupons === 'on', ship: store.services.ship === 'on' }),
          note: payments.binding.ready ? undefined : 'Payments says this account still needs attention, so checkouts may be refused until it is finished in the Payments plugin.',
        } : { siteId, error: SETTINGS_ERROR.forbidden };
      }
    }
  }
  if (form.get('action') === 'store_key' && siteId) {
    // The key is shown on this response only; it is never stored or put in a URL.
    const key = await replaceStoreKey(env.MERCHANT_DB, owner);
    if (key) newKey = { siteId, key };
  }
  if (!newKey && !shown) return seeOther('/account/sites');
}
const readMembership = await authorizeOrganization(env.MERCHANT_DB, merchant.userId, merchant.organizationId);
if (!readMembership || (readMembership.role !== 'owner' && !readMembership.permissions.includes('site:view'))) return new Response(null, { status: 403 });
const bindings = await listActiveBindings(env.MERCHANT_DB, merchant.subject);
const isOwner = readMembership.role === 'owner';
const stores = await listStoreSetup(env.MERCHANT_DB, merchant.subject);
const when = (seconds: number) => `${new Date(seconds * 1000).toISOString().slice(0, 16).replace('T', ' ')} UTC`;
const SERVICE_LABEL = { payments: 'Payments', coupons: 'Coupons', ship: 'Ship' } as const;
const comingSoon = (service: string) => (COMING_SOON_SERVICES as readonly string[]).includes(service);
const changedSite = Astro.url.searchParams.get('changed');
const saved = new Map(await Promise.all(stores.map(async store => [store.siteId, await loadCommerceSettings(env.MERCHANT_DB, store.siteId)] as const)));
const organizationId = Astro.url.searchParams.get('organization_id') ?? merchant.organizationId;
if (organizationId !== merchant.organizationId) return new Response(JSON.stringify({ error: 'stale_organization' }), { status: 409 });
if (!await authorizeOrganization(env.MERCHANT_DB, merchant.userId, organizationId)) return new Response(JSON.stringify({ error: 'organization_forbidden' }), { status: 403 });
---
<Site title="Your stores" description="The EmDash stores connected to your business and the DinkusKit services they use.">
  <div class="account-panel">
    <p class="eyebrow">{readMembership.name}</p>
    <h1>Your stores</h1>
    {bindings.length === 0 ? <p>No store is connected yet. Install the DinkusKit Payments plugin in your EmDash store, open its setup page and press Connect. You'll come back here to approve it.</p> : (
      <ul>
        {bindings.map(binding => (
          <li>
            <p>{binding.siteOrigin}</p>
            <p>Service: {binding.service}{!binding.revoked ? '' : binding.revokedBy === 'operator' ? ' (cut off by DinkusKit; contact DinkusKit to restore it)' : ' (revoked; press Connect in the store to connect again)'}</p>
            {binding.revoked || !isOwner ? null : (
              <form method="post" action="/account/sites" class="account-form">
                <input type="hidden" name="action" value="revoke" />
                <input type="hidden" name="site_id" value={binding.siteId} />
                <input type="hidden" name="service" value={binding.service} />
                <input type="hidden" name="organization_id" value={organizationId} />
                <button type="submit">Revoke {binding.service}</button>
              </form>
            )}
          </li>
        ))}
      </ul>
    )}
    {stores.length === 0 ? null : (
      <section aria-labelledby="commerce-setup">
        <h2 id="commerce-setup">Set up Commerce</h2>
        <p>Commerce uses one store key to reach the DinkusKit services you turn on below. Paste the key once into Commerce's settings in EmDash.</p>
        {stores.map(store => (
          <div class="account-form">
            <h3>{store.siteOrigin}</h3>
            <p>Store ID: <code>{store.siteId}</code></p>
            <ul>
              {(['payments', 'coupons', 'ship'] as const).map(service => (
                <li>
                  {SERVICE_LABEL[service]}: {store.services[service] === 'cut_off' ? 'Cut off by DinkusKit. Contact DinkusKit to have it restored.'
                    : store.services[service] === 'on' ? 'On' : service === 'payments' ? 'Off. Press Connect in the Payments plugin to turn it on.'
                    : comingSoon(service) ? 'Coming soon. Commerce does not take coupon codes yet.' : 'Off'}
                  {isOwner && service !== 'payments' && store.services[service] !== 'cut_off' && (store.services[service] === 'on' || !comingSoon(service)) ? (
                    <form method="post" action="/account/sites">
                      <input type="hidden" name="action" value="service" />
                      <input type="hidden" name="site_id" value={store.siteId} />
                      <input type="hidden" name="service" value={service} />
                      <input type="hidden" name="on" value={store.services[service] === 'on' ? '0' : '1'} />
                      <input type="hidden" name="organization_id" value={organizationId} />
                      <button type="submit">{store.services[service] === 'on' ? `Turn off ${SERVICE_LABEL[service]}` : `Turn on ${SERVICE_LABEL[service]}`}</button>
                    </form>
                  ) : null}
                </li>
              ))}
            </ul>
            <p>Store key: {store.key ? `created ${when(store.key.createdAt)}, ${store.key.lastUsedAt ? `last used ${when(store.key.lastUsedAt)}` : 'not used yet'}` : 'none yet'}</p>
            {newKey?.siteId === store.siteId ? (
              <div class="new-store-key">
                <p>Your new store key: <code id={`store-key-${store.siteId}`}>{newKey.key}</code></p>
                <button type="button" data-copy-target={`store-key-${store.siteId}`} data-copy-status={`store-key-status-${store.siteId}`} hidden>Copy store key</button>
                <p id={`store-key-status-${store.siteId}`} role="status" aria-live="polite"></p>
                <p>Copy it into Commerce's settings in EmDash now. It will not be shown again. If this store had a key before, that key has stopped working.</p>
              </div>
            ) : null}
            {isOwner ? (
              <form method="post" action="/account/sites">
                <input type="hidden" name="action" value="checkout_settings" />
                <input type="hidden" name="site_id" value={store.siteId} />
                <input type="hidden" name="organization_id" value={organizationId} />
                <fieldset>
                  <legend>Shipping charge</legend>
                  <label><input type="radio" name="shipping_mode" value="free" checked={saved.get(store.siteId)?.shippingMode !== 'flat'} /> Free</label>
                  <label><input type="radio" name="shipping_mode" value="flat" checked={saved.get(store.siteId)?.shippingMode === 'flat'} /> Flat amount in dollars</label>
                  <input type="text" name="shipping_amount" inputmode="decimal" aria-label="Flat shipping charge in dollars"
                    value={saved.get(store.siteId)?.shippingMode === 'flat' ? (saved.get(store.siteId)!.shippingMinor / 100).toFixed(2) : ''} />
                </fieldset>
                <fieldset>
                  <legend>Payments</legend>
                  <label><input type="radio" name="payments_mode" value="test" checked={!saved.get(store.siteId)?.live} /> Test (no real money)</label>
                  <label><input type="radio" name="payments_mode" value="live" checked={saved.get(store.siteId)?.live === true} /> Live (takes real money once Payments is live too)</label>
                </fieldset>
                <button type="submit">Show checkout settings</button>
              </form>
            ) : null}
            {changedSite === store.siteId ? <p role="status">You changed which services are on. Show the checkout settings again and paste them into Commerce, so Commerce uses the change.</p> : null}
            {shown?.siteId === store.siteId && shown.error ? <p class="account-error" role="alert">{shown.error}</p> : null}
            {shown?.siteId === store.siteId && shown.json ? (
              <div role="status">
                <p>Paste this into Commerce's checkout settings in EmDash, replacing what is there:</p>
                <pre><code>{shown.json}</code></pre>
                {shown.note ? <p>{shown.note}</p> : null}
              </div>
            ) : null}
            {isOwner ? (
              <form method="post" action="/account/sites">
                <input type="hidden" name="action" value="store_key" />
                <input type="hidden" name="site_id" value={store.siteId} />
                <input type="hidden" name="organization_id" value={organizationId} />
                <button type="submit">{store.key ? 'Replace key' : 'Create store key'}</button>
              </form>
            ) : null}
          </div>
        ))}
      </section>
    )}
    <p><a href="/account">Back to account</a></p>
  </div>
</Site>
<script>
  import { wireCopyButtons } from '../../account/copy-secret.ts';
  wireCopyButtons(document, document, window);
</script>
