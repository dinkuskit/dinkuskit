---
import type { BlockValue } from 'emdash/ui';
import { safeHttpUrl } from '../../scripts/lib/safe-http-url.mjs';

type StartStepValue = BlockValue & {
  heading?: string;
  body?: string;
  more_label?: string;
  more_body?: string;
  link_href?: string;
  link_label?: string;
  note?: string;
};

interface Props { steps: StartStepValue[] }
const steps = Astro.props.steps.map(step => ({ ...step, href: safeHttpUrl(step.link_href), linkLabel: step.link_label?.trim() }));
---
<ol class="start-steps">
  {steps.map((step, index) => {
    const link = step.href && step.linkLabel ? <p><a href={step.href}>{step.linkLabel}</a></p> : null;
    return (
      <li class="start-step" data-start-step={step._key}>
        <label>
          <span class="start-step-check-wrap">
            <input type="checkbox" data-start-check />
            <svg class="start-step-check-svg" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M 4.5 10.5 L 8.5 14.5 L 15.8 6.2" />
            </svg>
          </span>
          <span class="start-step-heading">
            {step.heading}
            <svg class="start-step-strike-svg" viewBox="0 0 240 12" preserveAspectRatio="none" aria-hidden="true">
              <path d="M 0 6 Q 120 4.5 240 6.5" />
            </svg>
            <svg class="start-step-rough-focus" viewBox="0 0 240 14" preserveAspectRatio="none" aria-hidden="true">
              <path class="rough-pass-1" d="M 2 9 Q 118 5 238 10" />
              <path class="rough-pass-2" d="M 6 12 Q 124 14 234 8" />
            </svg>
          </span>
        </label>
        <p id={`start-step-hint-${index + 1}`} class="start-hint" data-start-hint hidden></p>
        {step.body && <p>{step.body}</p>}
        {step.more_label ? (
          <details>
            <summary>{step.more_label}</summary>
            {step.more_body && <p>{step.more_body}</p>}
            {link}
          </details>
        ) : link}
        {step.note && <p class="start-note">{step.note}</p>}
      </li>
    );
  })}
</ol>
<script>
  // Ticks are a convenience kept in this browser only; the page works without them.
  const KEY = 'dinkuskit-start-steps';
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-start-step]'));
  const progress = document.querySelector<HTMLElement>('[data-start-progress]');
  const done = document.querySelector<HTMLElement>('[data-start-done]');
  // One bar segment per step, filled as that step is ticked.
  const bar = document.querySelector<HTMLElement>('[data-start-bar]');
  const segments = steps.map(() => bar?.appendChild(document.createElement('span')));
  let saved: unknown = [];
  try { saved = JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { saved = []; }
  const ticked = new Set(Array.isArray(saved) ? saved.filter(item => typeof item === 'string') : []);
  const render = () => {
    const firstUnticked = steps.findIndex(step => !step.querySelector<HTMLInputElement>('[data-start-check]')?.checked);
    const doneCount = firstUnticked === -1 ? steps.length : firstUnticked;
    const doneSteps = steps.slice(0, doneCount);
    const hintText = `Finish step ${doneCount + 1} first`;
    steps.forEach((step, index) => {
      const isDone = index < doneCount;
      const isNext = index === doneCount;
      const locked = index > doneCount;
      step.classList.toggle('is-done', isDone);
      step.classList.toggle('is-next', isNext);
      segments[index]?.classList.toggle('is-done', isDone);
      segments[index]?.classList.toggle('is-next', isNext);
      const box = step.querySelector<HTMLInputElement>('[data-start-check]');
      const label = step.querySelector<HTMLElement>('label');
      let hint = step.querySelector<HTMLElement>('[data-start-hint]');
      if (!hint) {
        hint = document.createElement('p');
        hint.className = 'start-hint';
        hint.dataset.startHint = '';
        step.append(hint);
      }
      if (!hint.id) hint.id = `start-step-hint-${index + 1}`;
      hint.textContent = locked ? hintText : '';
      hint.hidden = !locked;
      if (box) {
        box.checked = isDone;
        box.disabled = locked;
        if (locked) {
          box.title = hintText;
          box.setAttribute('aria-describedby', hint.id);
        } else {
          box.removeAttribute('title');
          box.removeAttribute('aria-describedby');
        }
      }
      if (label) {
        if (locked) label.title = hintText;
        else label.removeAttribute('title');
      }
    });
    if (bar) bar.hidden = false;
    const template = progress?.dataset.startProgress;
    if (progress && template) {
      const nextText = template.replace('{done}', String(doneSteps.length)).replace('{total}', String(steps.length));
      const changed = !progress.hidden && progress.textContent !== nextText;
      progress.hidden = false;
      progress.textContent = nextText;
      if (changed) {
        progress.dataset.bump = 'true';
        if (typeof setTimeout === 'function') setTimeout(() => { delete progress.dataset.bump; }, 220);
      }
    }
    if (done) done.hidden = doneSteps.length !== steps.length;
    try { localStorage.setItem(KEY, JSON.stringify(doneSteps.map(step => step.dataset.startStep))); } catch { /* not saved */ }
  };
  steps.forEach(step => {
    const box = step.querySelector<HTMLInputElement>('[data-start-check]');
    if (!box) return;
    box.checked = ticked.has(step.dataset.startStep ?? '');
    box.addEventListener('change', render);
  });
  if (steps.length) render();
</script>
