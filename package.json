{
  "name": "@dinkuskit/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The EmDash-powered DinkusKit website and hosted-service account foundation",
  "license": "MIT",
  "engines": {
    "node": ">=22.16 <23"
  },
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "setup": "node scripts/prepare-local.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "typecheck": "astro check",
    "audit:repo": "node scripts/audit-repo.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:account": "node --experimental-strip-types --test tests/emdash-public-auth-feasibility.test.mjs tests/merchant-auth-http.test.mjs && node --experimental-strip-types scripts/merchant-auth-proof.mjs",
    "verify": "npm run audit:repo && npm run setup && npm run typecheck && npm run test:account && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "6.0.5",
    "astro": "7.3.2",
    "better-sqlite3": "12.11.1",
    "emdash": "1.0.1",
    "jose": "6.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@emdash-cms/auth": "1.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  }
}
