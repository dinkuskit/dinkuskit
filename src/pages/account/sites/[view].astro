---
export const prerender = false;
import YourStores from '../../../components/account/YourStores.astro';
import { loadSitesPage } from '../../../account/sites-page.ts';

if (Astro.params.view !== 'archive') return new Response(null, { status: 404 });
Astro.response.headers.set('cache-control', 'private, no-store');
const result = await loadSitesPage({ request: Astro.request, url: Astro.url, merchant: Astro.locals.merchant, view: 'archive' });
if (result instanceof Response) return result;
---
<YourStores {...result} />
