---
import { PortableText } from 'emdash/ui';
import DocsHeading from './DocsHeading.astro';
import DocsNavigation from './DocsNavigation.astro';
import { docsPath, markdownPath, searchRecord, type DocArticle, type DocsSite } from '../catalog.ts';
import { headingAnchors } from '../portable-text.ts';
import '../docs.css';
interface Props {
  site: DocsSite;
  entry: DocArticle;
  entries: DocArticle[];
}
const { site, entry, entries } = Astro.props;
const anchors = headingAnchors(entry.body);
const body = entry.body.map((block, index) => {
  const heading = anchors.get(block._key ?? String(index));
  return heading ? { ...block, _anchor: heading.slug } : block;
});
const toc = [...anchors.values()].filter(heading => heading.depth === 2 || heading.depth === 3);
const headingComponents = Object.fromEntries(['h1', 'h2', 'h3', 'h4', 'h5', 'h6'].map(style => [style, DocsHeading]));
const index = entries.findIndex(item => item.id === entry.id);
const previous = entries[index - 1];
const next = entries[index + 1];
const searchData = JSON.stringify(entries.map(item => searchRecord(site, item))).replace(/</g, '\\u003c');
---
<div class="docs-toolbar">
  <a class="docs-home" href="/docs">Documentation <span aria-hidden="true">/</span></a>
  <span class="docs-section-name">{entry.section}</span>
  <button class="docs-menu-button" type="button" aria-controls="docs-drawer" aria-expanded="false" hidden>Browse docs</button>
</div>
<div class="docs-grid" data-docs-shell>
  <aside class="docs-sidebar" aria-label="Browse documentation">
    <div id="docs-browser">
      <div class="docs-search" hidden>
        <label for="docs-search-input">Search documentation</label>
        <input id="docs-search-input" type="search" placeholder="Search docs…" autocomplete="off" maxlength="160" aria-controls="docs-search-results" />
        <p class="docs-search-status" role="status" aria-live="polite"></p>
        <ul id="docs-search-results" class="docs-search-results" hidden></ul>
      </div>
      <DocsNavigation entries={entries} activeId={entry.id} />
    </div>
  </aside>
  <article class="docs-article" aria-labelledby="article-title">
    <div class="docs-article-heading">
      <p class="eyebrow">{entry.audience}</p>
      <h1 id="article-title">{entry.title}</h1>
      <p class="lead">{entry.summary}</p>
      <p class="docs-version">{entry.versionScope}</p>
      <div class="docs-page-actions">
        <span>Last updated <time datetime={entry.updated.toISOString().slice(0, 10)}>{entry.updated.toLocaleDateString('en-US', { dateStyle: 'medium', timeZone: 'UTC' })}</time></span>
        <button type="button" data-copy-markdown={markdownPath(entry.id)} hidden>Copy as Markdown</button>
        <a href={markdownPath(entry.id)}>View as Markdown</a>
        <span class="docs-copy-status" role="status" aria-live="polite"></span>
      </div>
      {entry.draft && (
        <p class="docs-draft"><strong>Draft for review.</strong> This article is not published. Drafts are only shown in local development.</p>
      )}
    </div>
    <div class="docs-prose"><PortableText value={body} components={{ block: headingComponents }} /></div>
    <nav class="docs-pagination" aria-label="Adjacent articles">
      {previous && <a href={docsPath(previous.id)}><span>Previous</span>{previous.title}</a>}
      {next && <a href={docsPath(next.id)}><span>Next</span>{next.title}</a>}
    </nav>
  </article>
  {toc.length > 1 && (
    <aside class="docs-toc" aria-label="On this page">
      <p>On this page</p>
      <ul>{toc.map(heading => <li class:list={{ 'docs-toc-subheading': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
    </aside>
  )}
</div>
<dialog id="docs-drawer" class="docs-drawer" aria-labelledby="docs-drawer-title">
  <div class="docs-drawer-header"><h2 id="docs-drawer-title">Documentation</h2><button type="button" data-close-docs>Close <span aria-hidden="true">×</span></button></div>
  <div data-drawer-content></div>
</dialog>
<script id="docs-search-data" type="application/json" set:html={searchData} />
<script>
  import { searchDocs } from '../search.ts';
  import type { SearchArticle } from '../search.ts';
  const copy = document.querySelector<HTMLButtonElement>('[data-copy-markdown]');
  const copyStatus = document.querySelector<HTMLElement>('.docs-copy-status');
  if (copy && copyStatus && navigator.clipboard?.write && 'ClipboardItem' in window) {
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      copy.disabled = true;
      copyStatus.textContent = '';
      // Start the clipboard write during the click, before awaiting the fetch.
      const markdown = fetch(copy.dataset.copyMarkdown!).then(async response => {
        if (!response.ok) throw new Error(`Markdown request failed: ${response.status}`);
        return new Blob([await response.text()], { type: 'text/plain' });
      });
      // A browser can refuse clipboard access before consuming the data promise.
      void markdown.catch(() => {});
      try {
        await navigator.clipboard.write([new ClipboardItem({ 'text/plain': markdown })]);
        copyStatus.textContent = 'Markdown copied.';
      } catch {
        copyStatus.textContent = 'Copy failed. Use View as Markdown to copy the article.';
      } finally {
        copy.disabled = false;
      }
    });
  }
  const input = document.querySelector<HTMLInputElement>('#docs-search-input');
  const results = document.querySelector<HTMLUListElement>('#docs-search-results');
  const status = document.querySelector<HTMLElement>('.docs-search-status');
  const nav = document.querySelector<HTMLElement>('.docs-navigation');
  const search = document.querySelector<HTMLElement>('.docs-search');
  const data: SearchArticle[] = JSON.parse(document.querySelector('#docs-search-data')?.textContent ?? '[]');
  if (input && results && status && nav && search) {
    search.hidden = false;
    input.addEventListener('input', () => {
      const query = input.value.trim();
      results.replaceChildren();
      nav.hidden = query.length > 0;
      results.hidden = query.length === 0;
      status.textContent = '';
      if (!query) return;
      const matches = searchDocs(data, query);
      status.textContent = matches.length ? `${matches.length} article${matches.length === 1 ? '' : 's'} found` : 'No matching articles. Try product, checkout, or add-on.';
      for (const item of matches) {
        const li = document.createElement('li');
        const link = document.createElement('a');
        const summary = document.createElement('span');
        link.href = item.url;
        link.textContent = item.title;
        summary.textContent = item.summary;
        li.append(link, summary);
        results.append(li);
      }
    });
  }
  const menu = document.querySelector<HTMLButtonElement>('.docs-menu-button');
  const drawer = document.querySelector<HTMLDialogElement>('#docs-drawer');
  const browser = document.querySelector<HTMLElement>('#docs-browser');
  const sidebar = document.querySelector<HTMLElement>('.docs-sidebar');
  const drawerContent = document.querySelector<HTMLElement>('[data-drawer-content]');
  if (menu && drawer && browser && sidebar && drawerContent && typeof drawer.showModal === 'function') {
    menu.hidden = false;
    document.querySelector('[data-docs-shell]')?.classList.add('docs-enhanced');
    menu.addEventListener('click', () => {
      drawerContent.append(browser);
      drawer.showModal();
      document.body.classList.add('docs-drawer-open');
      menu.setAttribute('aria-expanded', 'true');
      drawer.querySelector<HTMLButtonElement>('[data-close-docs]')?.focus();
    });
    drawer.addEventListener('close', () => {
      sidebar.append(browser);
      document.body.classList.remove('docs-drawer-open');
      menu.setAttribute('aria-expanded', 'false');
      menu.focus();
    });
    drawer.querySelector('[data-close-docs]')?.addEventListener('click', () => drawer.close());
    drawer.addEventListener('click', event => {
      const bounds = drawer.getBoundingClientRect();
      if (event.target === drawer && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) drawer.close();
    });
    drawer.addEventListener('click', event => {
      if ((event.target as HTMLElement).closest('a')) drawer.close();
    });
    window.matchMedia('(min-width: 901px)').addEventListener('change', event => {
      if (event.matches && drawer.open) drawer.close();
    });
  }
</script>
