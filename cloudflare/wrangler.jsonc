{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dinkuskit-website-cloudflare-candidate",
  "main": "./worker.ts",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "cddb32366789cab1bdf4c25584dc1920",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dinkuskit.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinkuskit-website-candidate",
      "database_id": "c3b20710-a7f4-49c5-bfd9-eff97d9903d9"
    },
    {
      "binding": "MERCHANT_DB",
      "database_name": "dinkuskit-merchant-production",
      "database_id": "54aeb445-14ce-4ed9-a949-3d3d1c17451c",
      "migrations_dir": "../migrations/merchant"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dinkuskit-website-candidate-media"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
