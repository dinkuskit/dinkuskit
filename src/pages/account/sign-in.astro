---
import Site from '../../layouts/Site.astro';
import { submitMagicLinkForm } from '../../account/actions.ts';

export const prerender = false;
if (Astro.request.method === 'POST') return submitMagicLinkForm(Astro, 'signin');
const error = Astro.url.searchParams.get('error');
---
<Site title="Sign in" description="Sign in to your DinkusKit merchant account.">
  <div class="account-panel">
    <p class="eyebrow">Merchant account</p>
    <h1>Sign in</h1>
    <p class="lead">Use the email for your DinkusKit account. This does not sign you into the website editor.</p>
    {error ? <p class="account-error" role="alert">Enter a valid email.</p> : null}
    <form method="post" action="/account/sign-in" class="account-form">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="200" />
      <button type="submit">Email me a sign-in link</button>
    </form>
    <p><a href="/account/recover">Need to recover access?</a></p>
    <p><a href="/account/signup">Create an account</a></p>
  </div>
</Site>
