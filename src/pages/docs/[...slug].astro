---
import { getVisibleDocs } from '../../docs/content.ts';
import { docsSite } from '../../docs/site.ts';
import DocsArticle from '../../docs/components/DocsArticle.astro';
import Site from '../../layouts/Site.astro';
const entries = await getVisibleDocs();
const entry = entries.find(item => item.id === Astro.params.slug);
if (!entry) Astro.response.status = 404;
if (entry?.draft) {
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
  Astro.response.headers.set('Cache-Control', 'no-store');
}
---
{entry ? (
  <Site title={entry.title} description={entry.summary} wide noindex={entry.draft}><DocsArticle site={docsSite} entry={entry} entries={entries} /></Site>
) : (
  <Site title="Page not found" description="This documentation page is not available."><div class="intro"><h1>Page not found.</h1><p>This documentation page is not available.</p><a href="/getting-started">Getting started</a></div></Site>
)}
