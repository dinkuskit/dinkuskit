---
import { OPERATOR_APPROVALS_PATH } from '../operator-admin/paths.ts';
import { getVisibleDocs } from '../docs/content.ts';
import { getMenu } from 'emdash';
import { SOCIAL_MENU, socialLinks } from '../components/social-links.ts';
import {
  DEFAULT_SOCIAL_IMAGE,
  DEFAULT_SOCIAL_IMAGE_ALT,
  SITE_NAME,
  canonicalUrl,
  corePageJsonLd,
  isNoIndexPathname,
  jsonLd,
  pageMetaDescription,
  seoTitle,
} from '../seo.ts';
interface Props {
  title: string;
  description: string;
  wide?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  structured?: Record<string, unknown> | null;
}
const { title, description, wide = false, noindex = false, ogType = 'website', structured } = Astro.props;
const hasDocs = (await getVisibleDocs()).length > 0;
const social = socialLinks((await getMenu(SOCIAL_MENU))?.items ?? []);
const shouldNoIndex = noindex || isNoIndexPathname(Astro.url.pathname) || Astro.response.status === 404;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const metaDesc = pageMetaDescription(Astro.url.pathname, description);
const fullTitle = seoTitle(title, Astro.url.pathname);
const socialImage = new URL(DEFAULT_SOCIAL_IMAGE, Astro.site).toString();
const structuredData = shouldNoIndex ? null : (structured === undefined ? corePageJsonLd(Astro.url.pathname, title, description) : structured);
// Round 3 type lock (Stitch F1): served from this site, not a font CDN.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/space-mono/700.css';
import '../styles/site.css';
import { Role } from '@emdash-cms/auth';
import SiteFooter from '../components/SiteFooter.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import DinkusGuide from '../../packages/dinkusguide-ui/src/Guide.astro';
import { guideAllowedPage, guidePilot } from '../guide/policy.ts';
const guide = guidePilot(import.meta.env.DINKUS_GUIDE_PILOT, import.meta.env.DINKUS_GUIDE_PLUGIN_ID);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDesc} />
    {shouldNoIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={DEFAULT_SOCIAL_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={DEFAULT_SOCIAL_IMAGE_ALT} />
    <title>{fullTitle}</title>
    <script is:inline>
      // A light/dark choice made with the header switch (ThemeSwitch.astro), applied before the page paints.
      try { const theme = localStorage.getItem('dinkuskit-theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch {}
    </script>
    {structuredData && <script type="application/ld+json" is:inline set:html={jsonLd(structuredData)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a class="brand" href="/"><img src="/brand/dinkuskit-f3-trio.webp" alt="" width="67" height="24" /> DinkusKit</a>
      <nav aria-label="Main navigation">
        <a href="/start" aria-current={Astro.url.pathname === '/start' ? 'page' : undefined}>Start your store</a>
        <a href="/getting-started">How it works</a>
        {hasDocs && <a href="/docs" aria-current={Astro.url.pathname.startsWith('/docs') ? 'true' : undefined}>Docs</a>}
        <a href="/account">Account</a>
        {Astro.locals.merchant ? <a href="/account/sites" aria-current={Astro.url.pathname === '/account/sites' || Astro.url.pathname === '/account/sites/archive' ? 'page' : undefined}>Your stores</a> : null}
        {Astro.locals.user?.role === Role.ADMIN && !Astro.locals.user.disabled ? <a href={OPERATOR_APPROVALS_PATH}>Operator admin</a> : null}
        <SocialLinks links={social} />
        <ThemeSwitch />
      </nav>
    </header>
    <main id="main" class:list={{ 'docs-main': wide }}><slot /></main>
    <SiteFooter />
    {guide && guideAllowedPage(Astro.url.pathname) && <DinkusGuide configUrl={guide.configUrl} askUrl={guide.askUrl} />}
  </body>
</html>
